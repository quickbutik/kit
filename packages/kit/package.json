{
	"name": "@quickbutik/kit",
	"version": "1.12.0",
	"description": "Bring-your-own-frontend SDK for Quickbutik — storefront API, React hooks and headless web components, driven by a publishable key",
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"unpkg": "./dist/quickbutik-kit.global.js",
	"jsdelivr": "./dist/quickbutik-kit.global.js",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./sdk": {
			"import": {
				"types": "./dist/sdk/index.d.ts",
				"default": "./dist/sdk/index.js"
			},
			"require": {
				"types": "./dist/sdk/index.d.cts",
				"default": "./dist/sdk/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react/index.d.ts",
				"default": "./dist/react/index.js"
			},
			"require": {
				"types": "./dist/react/index.d.cts",
				"default": "./dist/react/index.cjs"
			}
		},
		"./elements": {
			"import": {
				"types": "./dist/elements/index.d.ts",
				"default": "./dist/elements/index.js"
			},
			"require": {
				"types": "./dist/elements/index.d.cts",
				"default": "./dist/elements/index.cjs"
			}
		},
		"./global": "./dist/quickbutik-kit.global.js",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"@quickbutik:registry": "https://registry.npmjs.org",
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/quickbutik/kit.git",
		"directory": "packages/kit"
	},
	"engines": {
		"node": ">=18"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsup && node scripts/check-bundle.mjs && node scripts/check-entries.mjs",
		"lint": "biome check src/",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "~2.4.6",
		"@testing-library/react": "~16.3.0",
		"@types/node": "~22.15.21",
		"@types/react": "~19.2.0",
		"happy-dom": "~15.11.7",
		"react": "~19.2.1",
		"react-dom": "~19.2.1",
		"tsup": "~8.5.0",
		"typescript": "~5.9.2",
		"vitest": "~3.2.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
